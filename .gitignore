# Ignore dependencies, generated output, local runtime state, device diagnostics,
# and exported teaching data. Keep source, dependency lockfiles, shared Xcode
# configuration, design artwork, documented environment examples and test fixtures.
# Scope captures and temporary workspaces by path so source assets stay visible.
# Ignoring a path does not delete local data or untrack an existing Git file.
# Inspect a rule with: git check-ignore -v --no-index -- path/to/file

# JavaScript dependencies and package-manager caches
node_modules/
.npm-cache/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# Build output and frontend tool caches
dist/
build/
out/
output/
.vite/
.vite-temp/
*.tsbuildinfo
vite.config.*.timestamp-*

# Node.js and browser diagnostic dumps
*.heapsnapshot
*.cpuprofile
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
/core
/core.*
*.dmp

# Xcode / Swift build output and local IDE state
# Keep project files, shared schemes, asset catalogs, and source artwork tracked.
DerivedData/
.build/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.xcarchive/
*.xcarchive.zip
*.app/
*.xctest/
*.ipa
*.dSYM/
*.dSYM.zip
*.bcsymbolmap

# Exported iPad app containers and Xcode diagnostics
# Containers can include local models, poses, and pairing credentials.
*.xcappdata/
*.xcappdata.zip
*.xccrashpoint/
*.xccrashpoint.zip
*.xcdistributionlogs/
*.xcdistributionlogs.zip
*.xcactivitylog
*.crash
*.ips
*.trace/
*.trace.zip
*.memgraph

# Local Apple signing material
*.mobileprovision
*.provisionprofile
*.p12
*.p8

