/test-artifacts.zip
/test-artifacts-*.zip
/ipad/test-artifacts.zip
/ipad/test-artifacts-*.zip
/vision/test-artifacts.zip
/vision/test-artifacts-*.zip
.playwright/
.local-browsers/
ms-playwright/
playwright/.cache/
playwright/.auth/
*.lcov
*.xcresult/
*.xcresult.zip
*.xctestrun
*.xctestproducts
*.xctestproducts.zip
*.xccovreport
*.xccovarchive/
*.xccovarchive.zip
*.profraw
*.profdata

# UI smoke-test captures; scope device exports so source artwork stays visible.
/atlas-*.png
/transfer-*.png
# Browser recordings / traces saved beside smoke-test screenshots.
# Keep design media and fixtures outside these root-level filename patterns.
/atlas-*.mp4
/atlas-*.webm
/transfer-*.mp4
/transfer-*.webm
/atlas-*-trace.zip
/transfer-*-trace.zip
/atlas-ipad-*.mov
/atlas-ipad-*.heic
/ipad/atlas-ipad-*.png
/ipad/atlas-ipad-*.mp4
/ipad/atlas-ipad-*.mov
/ipad/atlas-ipad-*.heic

# xcresulttool exports UUID-named images, recordings, snapshots and a manifest.
# Include numbered retry folders such as atlas-ipad-level-shots-2.
/atlas-ipad-*-shots/
/atlas-ipad-*-shots-[0-9]*/
/ipad/atlas-ipad-*-shots/
/ipad/atlas-ipad-*-shots-[0-9]*/
/atlas-ipad-*-attachments/
/atlas-ipad-*-attachments-[0-9]*/
/ipad/atlas-ipad-*-attachments/
/ipad/atlas-ipad-*-attachments-[0-9]*/

# Ad-hoc device snapshots may contain local poses and pairing credentials.
# Limit these rules to diagnostic filenames, keeping app source/fixtures visible.
/atlas-ipad-*.json
/atlas-ipad-*.plist
/atlas-ipad-projects-*/
/ipad/atlas-ipad-*.json
/ipad/atlas-ipad-*.plist
/ipad/atlas-ipad-projects-*/

# USB pairing records created by local device-debugging tools contain credentials.
/atlas-ipad-*-pairing/
/ipad/atlas-ipad-*-pairing/

# Standalone Swift test executables produced during native iPad debugging.
/atlas-ipad-*-test
/atlas-ipad-*-tests
/ipad/atlas-ipad-*-test
/ipad/atlas-ipad-*-tests

# Isolated smoke-test workspaces if TMPDIR points into the repository.
/atlas-native-ipad-*/
/atlas-clean-build-*/
/ipad/atlas-native-ipad-*/
/ipad/atlas-clean-build-*/
# Node mkdtemp appends six random characters to the iPad / Vision Pro prefix.
/atlas-ipad-??????/
/ipad/atlas-ipad-??????/
/atlas-vision-??????/
/vision/atlas-vision-??????/

# Project import/export and server-result smoke-test workspaces.
/atlas-load-modes-*/
/atlas-project-directory-*/
/atlas-file-picker-*/
/atlas-portable-test-*/
/atlas-server-result-*/
# Download copied by tests/parking_merge_server_smoke.py.
/atlas-parking-merge-server-job.zip

# Pairing/discovery smoke-test workspaces when TMPDIR is inside the repository.
/atlas-pairing-code-*/
/atlas-pairing-qr-*/
/atlas-discovery-*/
/ipad/atlas-pairing-code-*/
/ipad/atlas-pairing-qr-*/
/ipad/atlas-discovery-*/

# ABX contract-test source copies, temporary imports and UI captures
/atlas-abx-export-*/
/atlas-abx-ui-*/

