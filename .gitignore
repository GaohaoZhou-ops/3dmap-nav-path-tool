*.swp
*.swo
*~

# Local robot assets can be large and machine-specific
robots/

# Point-cloud assets are ignored by default; keep compact repository fixtures
*.[pP][lL][yY]
!maps/xian_map.ply
!tests/fixtures/*.[pP][lL][yY]
!tests/fixtures/**/*.[pP][lL][yY]
!ipad/Tests/Fixtures/*.[pP][lL][yY]
!ipad/Tests/Fixtures/**/*.[pP][lL][yY]
!vision/Tests/Fixtures/*.[pP][lL][yY]
!vision/Tests/Fixtures/**/*.[pP][lL][yY]

# Local iPad / Vision Pro model-transfer payloads; keep test fixtures trackable.
*.atls
!tests/fixtures/*.atls
!tests/fixtures/**/*.atls
!ipad/Tests/Fixtures/*.atls
!ipad/Tests/Fixtures/**/*.atls
!vision/Tests/Fixtures/*.atls
!vision/Tests/Fixtures/**/*.atls

# Locally recovered/exported projects may contain hundreds of MB of map data
recovered-projects/
*.atlas-project/
*.atlas-project.zip

