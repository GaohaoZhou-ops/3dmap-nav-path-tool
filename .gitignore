*.swp
*.swo
*~

# Local robot assets can be large and machine-specific
robots/

# Point-cloud assets are ignored by default; keep compact repository fixtures
*.[pP][lL][yY]
!maps/xian_map.ply
!tests/fixtures/*.[pP][lL][yY]
!tests/fixtures/**/*.[pP][lL][yY]

# Locally recovered/exported projects may contain hundreds of MB of map data
recovered-projects/
*.atlas-project/
*.atlas-project.zip

# Exported teaching archives and parking-merge jobs/results
virtual-teaching-*.zip
virtual-teaching-*.json
/virtual-teaching-*/
parking-merge-server-*.zip
parking-merge-server-*/
parking-merge-*-result.zip
parking-merge-*-result.json
